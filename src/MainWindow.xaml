<Window x:Class="ArcSyncSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArcSyncSwitch"
        Title="ArcSyncSwitch" Icon="app.ico" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource Fg}">
  <Border Style="{StaticResource Frame}">
    <StackPanel Margin="22,16,22,20">
      <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="ArcSyncSwitch" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="HeaderStatus" Foreground="{DynamicResource Sub}" FontSize="12" Margin="12,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="CloseBtn" Grid.Column="1" Style="{StaticResource Close}" Click="CloseBtn_Click" ToolTip="{DynamicResource Str_CloseTip}"/>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="4,14,0,6">
        <TextBlock Text="{DynamicResource Str_SecVrr}" Style="{StaticResource Label}" Margin="0"/>
        <local:HelpTip Text="{DynamicResource Str_TipVrr}"/>
      </StackPanel>

      <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,12">
        <StackPanel>
          <Border Style="{StaticResource SegBox}">
            <UniformGrid Rows="1">
              <RadioButton x:Name="ModeFull" Content="{DynamicResource Str_ModeFull}" GroupName="vrrmode" Style="{StaticResource Seg}" Checked="Mode_Checked"/>
              <RadioButton x:Name="ModeStock" Content="{DynamicResource Str_ModeStock}" GroupName="vrrmode" Style="{StaticResource Seg}" Checked="Mode_Checked"/>
              <RadioButton x:Name="ModeOff" Content="{DynamicResource Str_ModeOff}" GroupName="vrrmode" Style="{StaticResource Seg}" Checked="Mode_Checked"/>
            </UniformGrid>
          </Border>
          <TextBlock x:Name="ModeDescription" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0"/>
        </StackPanel>
      </Border>

      <TextBlock Text="{DynamicResource Str_SecDriver}" Style="{StaticResource Label}"/>

      <Border CornerRadius="14" Background="{DynamicResource Card}" Padding="14,4">
        <StackPanel>
          <Grid Margin="0,8">
            <StackPanel Margin="0,0,56,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_LfcTitle}" FontWeight="SemiBold"/>
                <local:HelpTip Text="{DynamicResource Str_TipLfc}"/>
              </StackPanel>
              <TextBlock x:Name="LfcSub" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="LfcSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="LfcSwitch_Changed" Unchecked="LfcSwitch_Changed"/>
          </Grid>

          <Border Height="1" Background="{DynamicResource Border}"/>

          <Grid Margin="0,8">
            <StackPanel Margin="0,0,56,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_AutostartTitle}" FontWeight="SemiBold"/>
                <local:HelpTip Text="{DynamicResource Str_TipAutostart}"/>
              </StackPanel>
              <TextBlock Text="{DynamicResource Str_AutostartSub}" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="AutostartSwitch_Changed" Unchecked="AutostartSwitch_Changed"/>
          </Grid>

          <Border Height="1" Background="{DynamicResource Border}"/>

          <Grid Margin="0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Str_LangTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <local:HelpTip Text="{DynamicResource Str_TipLang}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SegBox}" Width="168">
              <UniformGrid Rows="1">
                <RadioButton x:Name="LangAuto" Content="{DynamicResource Str_LangAuto}" GroupName="uilang" Style="{StaticResource Seg}" Checked="Lang_Checked"/>
                <RadioButton x:Name="LangRu" Content="RU" GroupName="uilang" Style="{StaticResource Seg}" Checked="Lang_Checked"/>
                <RadioButton x:Name="LangEn" Content="EN" GroupName="uilang" Style="{StaticResource Seg}" Checked="Lang_Checked"/>
              </UniformGrid>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Margin="2,14,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterStatus" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,12,0"/>
        <Button x:Name="RefreshBtn" Grid.Column="1" Content="{DynamicResource Str_Refresh}" Style="{StaticResource Flat}" Click="RefreshBtn_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
